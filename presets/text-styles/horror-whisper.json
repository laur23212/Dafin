{
  "format": 1,
  "id": "chatgpt.horror-whisper",
  "label": "Horror Whisper",
  "description": "Restrained, unsettling pale letterforms with gentle motion.",
  "category": "horror",
  "tags": [
    "dafin",
    "v3",
    "editorial"
  ],
  "kind": "title",
  "sampleText": "WHO WAS THERE?",
  "requires": {
    "fonts": [
      "Noto Serif"
    ]
  },
  "style": {
    "fontFamily": "Noto Serif",
    "fontWeight": 400,
    "pixelSize": 98,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.17,
    "letterSpacing": 1.2,
    "textCase": "upper",
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "opacity": 0.56,
        "offsetY": 5,
        "blur": 9
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#DFE8E4"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "unit": "block",
          "stagger": 0,
          "duration": 0.12,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "unit": "block",
          "duration": 0.16,
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      },
      "loop": {
        "preset": "breathe",
        "params": {
          "amount": 0.06,
          "speed": 0.32
        }
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Size",
      "type": "scalar",
      "bind": "font.size",
      "min": 47,
      "max": 147,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Ink color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "duration",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    },
    {
      "id": "subtleloop",
      "label": "Subtle movement",
      "type": "bool",
      "bind": "animation.loop.enabled"
    }
  ]
}
