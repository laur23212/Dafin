{
  "format": 1,
  "id": "chatgpt.creator-safety-disclaimer",
  "label": "Creator Safety Disclaimer",
  "description": "Accessible illustrative disclaimer caption (not a legal guarantee)",
  "category": "education",
  "tags": [
    "chatgpt-v10",
    "functional",
    "education"
  ],
  "kind": "caption",
  "sampleText": "FOR DEMO ONLY",
  "requires": {
    "fonts": [
      "Inter"
    ]
  },
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 600,
    "pixelSize": 55,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 2,
    "textCase": "none",
    "layers": [
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#3F241C"
        },
        "width": 4,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFF2DC"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.09,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 250
      }
    },
    "boxEnabled": true,
    "boxColor": "#E63F241C",
    "boxPadding": 10,
    "boxRadius": 3
  },
  "effects": [],
  "controls": [
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "boxcolor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
