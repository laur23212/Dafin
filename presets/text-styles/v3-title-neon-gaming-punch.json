{
  "format": 1,
  "id": "chatgpt.v3.title.neon-gaming-punch",
  "label": "Neon Gaming Punch",
  "description": "Energetic game announcement with playful lettering",
  "category": "v3-gaming",
  "kind": "title",
  "sampleText": "GAME OVER!",
  "tags": [
    "v3",
    "editable",
    "kinetic-typography",
    "gaming"
  ],
  "requires": {
    "fonts": [
      "Comic Neue"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Comic Neue",
    "pixelSize": 108,
    "fontWeight": 700,
    "italic": false,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ff27134b"
        },
        "opacity": 0.7,
        "blend": "normal",
        "offsetX": 3.2,
        "offsetY": 5.2,
        "blur": 4.2,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      },
      {
        "id": "stroke",
        "kind": "stroke",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ff27134b"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2,
        "spread": 0.0,
        "scope": "all",
        "strokeAlign": "outside",
        "dash": "solid",
        "join": "round",
        "dashOffset": 0
      },
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ffffff7d"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.06,
    "letterSpacing": -0.6,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": false,
    "boxColor": "#ff27134b",
    "boxPadding": 12,
    "boxRadius": 6,
    "underlineEnabled": false,
    "underlineColor": "#fffe9382",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "in": {
        "preset": "dafin.v3.anim.rapid-game-callout",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.16
          }
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.19
          }
        }
      },
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Font size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Primary colour",
      "type": "color",
      "bind": "layer.fill.color"
    }
  ]
}
