{
  "format": 1,
  "id": "chatgpt.v2.signature.lobster-two.opener",
  "label": "Lobster Two Hero",
  "description": "Creator sign-off using the exact Lobster Two face; editable native layers and typography.",
  "category": "v2-signature",
  "kind": "title",
  "sampleText": "A personal story",
  "tags": [
    "v2",
    "type-diversity",
    "signature",
    "opener",
    "creator sign-off"
  ],
  "requires": {
    "fonts": [
      "Lobster Two"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Lobster Two",
    "pixelSize": 104,
    "fontWeight": 400,
    "italic": false,
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ff472e34"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": false,
    "boxColor": "#ff5c2a49",
    "boxPadding": 12,
    "boxRadius": 6,
    "underlineEnabled": false,
    "underlineColor": "#ffb06b48",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.32
          },
          "stagger": {
            "type": "scalar",
            "value": 0
          },
          "unit": {
            "type": "text",
            "value": "block"
          },
          "ease": {
            "type": "text",
            "value": "easeOut"
          }
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.2
          }
        }
      },
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "font-size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "font-colour",
      "label": "Primary ink",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "in-duration",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0.05,
      "max": 1.25,
      "unit": "s"
    }
  ]
}
