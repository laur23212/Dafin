{
  "format": 1,
  "id": "chatgpt.kids-spelling-prompt",
  "label": "Kids Spelling Prompt",
  "description": "Simple highly legible interactive spelling prompt.",
  "category": "kids",
  "tags": [
    "kids",
    "dafin-v4",
    "chatgpt"
  ],
  "kind": "title",
  "sampleText": "SPELL: LAUREL",
  "requires": {
    "fonts": [
      "Fredoka"
    ]
  },
  "style": {
    "fontFamily": "Fredoka",
    "fontWeight": 600,
    "pixelSize": 104,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 1,
    "textCase": "none",
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 0,
        "offsetY": 5,
        "blur": 9,
        "opacity": 0.45
      },
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#294568"
        },
        "width": 5,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFFFFF"
        }
      }
    ],
    "boxEnabled": true,
    "boxColor": "#294568",
    "boxPadding": 21,
    "boxRadius": 14,
    "underlineEnabled": false,
    "underlineColor": "#F5BA58",
    "underlineWidth": 4,
    "underlineOffset": 8,
    "animation": {
      "in": {
        "preset": "pop",
        "params": {
          "duration": 0.13,
          "ease": "easeOut",
          "unit": "block",
          "from": 88
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.16,
          "ease": "easeIn",
          "unit": "block"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 180
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Displayed text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 34,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "textcolor",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color",
      "group": "Colors"
    },
    {
      "id": "outlinecolor",
      "label": "Outline color",
      "type": "color",
      "bind": "layer.outline.color",
      "group": "Colors"
    },
    {
      "id": "cardcolor",
      "label": "Background card",
      "type": "color",
      "bind": "box.color",
      "group": "Colors"
    },
    {
      "id": "padding",
      "label": "Card padding",
      "type": "scalar",
      "bind": "boxPadding",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "group": "Layout"
    },
    {
      "id": "entrance",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.18,
      "step": 0.01,
      "unit": "s",
      "group": "Motion"
    },
    {
      "id": "radius",
      "label": "Card corners",
      "type": "scalar",
      "bind": "box.radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "group": "Layout"
    }
  ]
}
