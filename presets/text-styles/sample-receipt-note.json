{
  "format": 1,
  "id": "chatgpt.sample-receipt-note",
  "label": "Sample Receipt Note",
  "description": "Receipt/financial screen annotation with user-provided text",
  "category": "gaming",
  "tags": [
    "batch09",
    "functional"
  ],
  "kind": "lower-third",
  "sampleText": "RECEIPT · EXAMPLE",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 500,
    "pixelSize": 54,
    "italic": false,
    "align": "left",
    "valign": "bottom",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 2.2,
    "textCase": "none",
    "boxEnabled": false,
    "boxColor": "#502F21",
    "boxPadding": 7,
    "boxRadius": 16,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 3,
        "offsetY": 3,
        "blur": 14,
        "opacity": 0.43
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFF5D7"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.13,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "underlineEnabled": true,
    "underlineColor": "#FFF5D7",
    "underlineWidth": 2,
    "underlineOffset": 9
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Main text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Font size",
      "type": "scalar",
      "bind": "font.size",
      "min": 18,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "font",
      "label": "Font family",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "color",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "underline",
      "label": "Accent underline",
      "type": "bool",
      "bind": "underline.enabled"
    },
    {
      "id": "underlineColor",
      "label": "Accent color",
      "type": "color",
      "bind": "underline.color"
    },
    {
      "id": "entrance",
      "label": "Entrance length",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
