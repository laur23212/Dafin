{
  "format": 1,
  "id": "chatgpt.recording-take-slate",
  "label": "Recording Take Slate",
  "description": "One-line production take identifier for behind-the-scenes edits and filmmaking tutorials.",
  "category": "technical",
  "tags": [
    "recording-take-slate",
    "dafin-v7",
    "editorial"
  ],
  "kind": "lower-third",
  "sampleText": "SCENE 04  /  TAKE 02",
  "requires": {
    "fonts": [
      "IBM Plex Mono"
    ]
  },
  "style": {
    "fontFamily": "IBM Plex Mono",
    "fontWeight": 600,
    "pixelSize": 53,
    "italic": false,
    "align": "left",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 0.5,
    "textCase": "upper",
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#ffffff"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "stagger": 0,
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "boxEnabled": true,
    "boxColor": "#dd101820",
    "boxPadding": 14,
    "boxRadius": 0,
    "underlineEnabled": true,
    "underlineColor": "#f0cc6a",
    "underlineWidth": 3,
    "underlineOffset": 8,
    "underlineReveal": 1
  },
  "effects": [],
  "controls": [
    {
      "id": "words",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Font size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "text_colour",
      "label": "Text colour",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box_colour",
      "label": "Panel colour",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "box_toggle",
      "label": "Show panel",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "accent_colour",
      "label": "Accent colour",
      "type": "color",
      "bind": "underline.color"
    },
    {
      "id": "entrance",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.18,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
