{
  "format": 1,
  "id": "chatgpt.suite.captions-subtitles-accessible-yellow",
  "label": "Accessible Yellow",
  "description": "Captions Subtitles: caption treatment with Inter Display and none entrance.",
  "category": "captions-subtitles",
  "tags": [
    "captions-subtitles",
    "caption",
    "none",
    "editable",
    "font-paired"
  ],
  "sampleText": "IMPORTANT INFORMATION",
  "kind": "caption",
  "requires": {
    "fonts": [
      "Inter Display"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Inter Display",
    "pixelSize": 58,
    "fontWeight": 700,
    "italic": false,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ff22222c"
        },
        "opacity": 0.38,
        "blend": "normal",
        "offsetX": 2.4,
        "offsetY": 3.0,
        "blur": 4.5,
        "width": 2,
        "spread": 0,
        "scope": "all"
      },
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#fffff4c2"
        },
        "opacity": 1,
        "blend": "normal",
        "offsetX": 0,
        "offsetY": 0,
        "blur": 0,
        "width": 2,
        "spread": 0,
        "scope": "all"
      }
    ],
    "pathBend": 0,
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 0.0,
    "textCase": "none",
    "boxEnabled": true,
    "boxColor": "#ef060913",
    "boxPadding": 16,
    "boxRadius": 7,
    "underlineEnabled": false,
    "underlineColor": "#ffffb900",
    "underlineWidth": 2.7,
    "underlineOffset": 6,
    "animation": {
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 22,
      "max": 230,
      "unit": "px"
    },
    {
      "id": "color",
      "label": "Text colour",
      "type": "color",
      "bind": "layer.fill.color"
    }
  ]
}
