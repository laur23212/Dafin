{
  "format": 1,
  "id": "chatgpt.flashcard-question-face",
  "label": "Flashcard Question Face",
  "description": "Question-face prompt for active-learning videos",
  "category": "sport",
  "tags": [
    "batch09",
    "functional"
  ],
  "kind": "title",
  "sampleText": "FLASHCARD · WHY?",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 700,
    "pixelSize": 88,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 0.8,
    "textCase": "upper",
    "boxEnabled": true,
    "boxColor": "#322434",
    "boxPadding": 14,
    "boxRadius": 3,
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#F0DFE8"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.13,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Main text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Font size",
      "type": "scalar",
      "bind": "font.size",
      "min": 18,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "font",
      "label": "Font family",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "color",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "background",
      "label": "Card background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "backgroundColor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance length",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    },
    {
      "id": "spacing",
      "label": "Letter spacing",
      "type": "scalar",
      "bind": "letterSpacing",
      "min": 0,
      "max": 12,
      "step": 0.2,
      "unit": "px"
    }
  ]
}
