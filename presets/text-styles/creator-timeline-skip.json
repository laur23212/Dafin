{
  "format": 1,
  "id": "chatgpt.creator-timeline-skip",
  "label": "Creator Timeline Skip",
  "description": "Manual timeline timestamp cue for a long-form video",
  "category": "social",
  "tags": [
    "chatgpt-v10",
    "functional",
    "social"
  ],
  "kind": "lower-third",
  "sampleText": "SKIP TO / 2:30",
  "requires": {
    "fonts": [
      "IBM Plex Mono"
    ]
  },
  "style": {
    "fontFamily": "IBM Plex Mono",
    "fontWeight": 700,
    "pixelSize": 67,
    "italic": false,
    "align": "left",
    "valign": "bottom",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0,
    "textCase": "upper",
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#F4F0FF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "pop",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut",
          "from": 75
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "boxEnabled": true,
    "boxColor": "#E62C2748",
    "boxPadding": 16,
    "boxRadius": 10
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Edit words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "boxcolor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
