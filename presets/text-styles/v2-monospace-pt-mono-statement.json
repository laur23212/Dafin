{
  "format": 1,
  "id": "chatgpt.v2.monospace.pt-mono.statement",
  "label": "PT Mono Statement",
  "description": "Data status using the exact PT Mono face; editable native layers and typography.",
  "category": "v2-monospace",
  "kind": "title",
  "sampleText": "STATUS: COMPLETE",
  "tags": [
    "v2",
    "type-diversity",
    "monospace",
    "statement",
    "data status"
  ],
  "requires": {
    "fonts": [
      "PT Mono"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "PT Mono",
    "pixelSize": 68,
    "fontWeight": 600,
    "italic": false,
    "layers": [
      {
        "id": "glow",
        "kind": "glow",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#fffff4d2"
        },
        "opacity": 0.33,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 9,
        "width": 2,
        "spread": 0.0,
        "scope": "all"
      },
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#fffff4d2"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0.5,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": true,
    "boxColor": "#f52c3b50",
    "boxPadding": 16,
    "boxRadius": 6,
    "underlineEnabled": false,
    "underlineColor": "#fffff4d2",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "in": {
        "preset": "blur-in",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.18
          },
          "stagger": {
            "type": "scalar",
            "value": 0
          },
          "unit": {
            "type": "text",
            "value": "block"
          }
        }
      },
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "font-size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "font-colour",
      "label": "Primary ink",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "in-duration",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0.05,
      "max": 1.25,
      "unit": "s"
    }
  ]
}
