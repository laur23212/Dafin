{
  "format": 1,
  "id": "chatgpt.vertical-story-hook",
  "label": "Vertical Story Hook",
  "description": "Compact tall-format opener designed for short social videos.",
  "category": "social",
  "tags": [
    "dafin-v6",
    "practical",
    "original"
  ],
  "kind": "title",
  "sampleText": "ONE THING TO KNOW",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 600,
    "pixelSize": 110,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 1.8,
    "textCase": "none",
    "boxEnabled": true,
    "boxColor": "#DA132F2C",
    "boxPadding": 24,
    "boxRadius": 14,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 1,
        "offsetY": 4,
        "blur": 10,
        "opacity": 0.5
      },
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#0C302A"
        },
        "width": 3,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#F5FFE9"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "copy",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 20,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "fg",
      "label": "Text colour",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "bg",
      "label": "Box colour",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "edge",
      "label": "Outline colour",
      "type": "color",
      "bind": "layer.outline.color"
    },
    {
      "id": "enter",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
