{
  "format": 1,
  "id": "chatgpt.v3.title.typewriter-caption",
  "label": "Typewriter Caption",
  "description": "Native editable typewriter in a modern monospaced font",
  "category": "v3-typewriter",
  "kind": "title",
  "sampleText": "NEXT STEP: ADD MUSIC",
  "tags": [
    "v3",
    "editable",
    "kinetic-typography",
    "typewriter"
  ],
  "requires": {
    "fonts": [
      "Cousine"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Cousine",
    "pixelSize": 72,
    "fontWeight": 600,
    "italic": false,
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ffecfbff"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0.5,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": true,
    "boxColor": "#ff182b38",
    "boxPadding": 12,
    "boxRadius": 6,
    "underlineEnabled": false,
    "underlineColor": "#fffff4d2",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "in": {
        "preset": "typewriter",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 1.2
          }
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.19
          }
        }
      },
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Font size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Primary colour",
      "type": "color",
      "bind": "layer.fill.color"
    }
  ]
}
