{
  "format": 1,
  "id": "chatgpt.comparison-winner-label",
  "label": "Comparison Winner Label",
  "description": "Decision badge in text form for product comparison wrap-ups",
  "category": "reviews",
  "tags": [
    "chatgpt-v10",
    "functional",
    "reviews"
  ],
  "kind": "title",
  "sampleText": "EDITOR PICK",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 700,
    "pixelSize": 93,
    "italic": false,
    "align": "left",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 3,
    "textCase": "upper",
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFF6CF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.09,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "boxEnabled": true,
    "boxColor": "#E6293045",
    "boxPadding": 16,
    "boxRadius": 10
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Edit words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "boxcolor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
