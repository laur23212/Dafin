{
  "format": 1,
  "id": "chatgpt.v2.monospace.cousine.label",
  "label": "Cousine Nameplate",
  "description": "Tutorial step using the exact Cousine face; editable native layers and typography.",
  "category": "v2-monospace",
  "kind": "lower-third",
  "sampleText": "STEP_03: EXPORT",
  "tags": [
    "v2",
    "type-diversity",
    "monospace",
    "label",
    "tutorial step"
  ],
  "requires": {
    "fonts": [
      "Cousine"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Cousine",
    "pixelSize": 49,
    "fontWeight": 600,
    "italic": false,
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#fffff4d2"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0.5,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": true,
    "boxColor": "#f52c3b50",
    "boxPadding": 16,
    "boxRadius": 6,
    "underlineEnabled": false,
    "underlineColor": "#fffff4d2",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "font-size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "font-colour",
      "label": "Primary ink",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box-padding",
      "label": "Label padding",
      "type": "scalar",
      "bind": "boxPadding",
      "min": 0,
      "max": 50,
      "unit": "px"
    }
  ]
}
