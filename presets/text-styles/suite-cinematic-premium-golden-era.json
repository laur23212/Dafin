{
  "format": 1,
  "id": "chatgpt.suite.cinematic-premium-golden-era",
  "label": "Golden Era",
  "description": "Cinematic Premium: gradient treatment with Noto Serif Display and wipe entrance.",
  "category": "cinematic-premium",
  "tags": [
    "cinematic-premium",
    "gradient",
    "wipe",
    "editable",
    "font-paired"
  ],
  "sampleText": "A NEW BEGINNING",
  "kind": "title",
  "requires": {
    "fonts": [
      "Noto Serif Display"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Noto Serif Display",
    "pixelSize": 78,
    "fontWeight": 500,
    "italic": false,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ff291a11"
        },
        "opacity": 0.65,
        "blend": "normal",
        "offsetX": 2.4,
        "offsetY": 3.0,
        "blur": 4.5,
        "width": 2,
        "spread": 0,
        "scope": "all"
      },
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "gradient",
          "color": "#fffff5e7",
          "gradient": {
            "kind": "linear",
            "stops": [
              {
                "pos": 0,
                "color": "#fffff5e7"
              },
              {
                "pos": 1,
                "color": "#ffffb44f"
              }
            ],
            "angle": -15,
            "offset": 0,
            "offsetSpeed": 0,
            "scale": 1,
            "center": [
              0.5,
              0.5
            ],
            "repeat": false,
            "oklab": true,
            "space": "block"
          }
        },
        "opacity": 1,
        "blend": "normal",
        "offsetX": 0,
        "offsetY": 0,
        "blur": 0,
        "width": 2,
        "spread": 0,
        "scope": "all"
      }
    ],
    "pathBend": 0,
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.08,
    "letterSpacing": 0.0,
    "textCase": "none",
    "boxEnabled": false,
    "boxColor": "#ff291a11",
    "boxPadding": 20,
    "boxRadius": 7,
    "underlineEnabled": false,
    "underlineColor": "#ffffb44f",
    "underlineWidth": 2.7,
    "underlineOffset": 6,
    "animation": {
      "in": {
        "preset": "wipe",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.34
          },
          "stagger": {
            "type": "scalar",
            "value": 0.008
          },
          "unit": {
            "type": "text",
            "value": "block"
          },
          "ease": {
            "type": "text",
            "value": "easeOut"
          }
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.2
          }
        }
      },
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 22,
      "max": 230,
      "unit": "px"
    },
    {
      "id": "in-duration",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0.05,
      "max": 1.5,
      "unit": "s"
    }
  ]
}
