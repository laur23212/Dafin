{
  "format": 1,
  "id": "chatgpt.v2.condensed.pt-sans-narrow.opener",
  "label": "PT Sans Narrow Hero",
  "description": "News/sports opener using the exact PT Sans Narrow face; editable native layers and typography.",
  "category": "v2-condensed",
  "kind": "title",
  "sampleText": "BUILT FOR SPEED",
  "tags": [
    "v2",
    "type-diversity",
    "condensed",
    "opener",
    "news/sports opener"
  ],
  "requires": {
    "fonts": [
      "PT Sans Narrow"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "PT Sans Narrow",
    "pixelSize": 112,
    "fontWeight": 800,
    "italic": false,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ff0c2035"
        },
        "opacity": 0.68,
        "blend": "normal",
        "offsetX": 3.2,
        "offsetY": 5.2,
        "blur": 4.2,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      },
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ffffffff"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.06,
    "letterSpacing": -0.6,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": false,
    "boxColor": "#ff253f66",
    "boxPadding": 12,
    "boxRadius": 6,
    "underlineEnabled": false,
    "underlineColor": "#ff66e5e1",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "in": {
        "preset": "slide-up",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.2
          },
          "stagger": {
            "type": "scalar",
            "value": 0
          },
          "unit": {
            "type": "text",
            "value": "block"
          },
          "ease": {
            "type": "text",
            "value": "easeOut"
          }
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": {
            "type": "scalar",
            "value": 0.2
          }
        }
      },
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "font-size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "font-colour",
      "label": "Primary ink",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "in-duration",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0.05,
      "max": 1.25,
      "unit": "s"
    }
  ]
}
