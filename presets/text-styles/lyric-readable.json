{
  "format": 1,
  "id": "chatgpt.lyric-readable",
  "label": "Lyric Readable",
  "description": "Soft contrast subtitle/lyric treatment; per-cue words supplied by Dafin.",
  "category": "captions",
  "tags": [
    "dafin",
    "v3",
    "editorial"
  ],
  "kind": "caption",
  "sampleText": "You are the light",
  "requires": {
    "fonts": [
      "DM Sans"
    ]
  },
  "style": {
    "fontFamily": "DM Sans",
    "fontWeight": 700,
    "pixelSize": 75,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.17,
    "letterSpacing": 1.2,
    "textCase": "none",
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFFFFF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "unit": "block",
          "stagger": 0,
          "duration": 0.12,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "unit": "block",
          "duration": 0.16,
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 250
      }
    },
    "boxEnabled": true,
    "boxColor": "#B0182635",
    "boxPadding": 16,
    "boxRadius": 10
  },
  "effects": [],
  "controls": [
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Size",
      "type": "scalar",
      "bind": "font.size",
      "min": 36,
      "max": 112,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Ink color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box",
      "label": "Box",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "panelcolor",
      "label": "Panel color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "duration",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
