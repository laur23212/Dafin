{
  "format": 1,
  "id": "chatgpt.live-chat-reminder",
  "label": "Live Chat Reminder",
  "description": "Livestream audience participation invitation",
  "category": "livestream",
  "tags": [
    "chatgpt-v10",
    "functional",
    "livestream"
  ],
  "kind": "title",
  "sampleText": "JOIN THE CHAT",
  "requires": {
    "fonts": [
      "DM Sans"
    ]
  },
  "style": {
    "fontFamily": "DM Sans",
    "fontWeight": 700,
    "pixelSize": 94,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 1,
    "textCase": "upper",
    "layers": [
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#253353"
        },
        "width": 6,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#E1FAFF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "underlineEnabled": true,
    "underlineColor": "#26A8EA",
    "underlineWidth": 4,
    "underlineOffset": 7
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Edit words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "underline",
      "label": "Underline",
      "type": "bool",
      "bind": "underline.enabled"
    },
    {
      "id": "accent",
      "label": "Accent color",
      "type": "color",
      "bind": "underline.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
