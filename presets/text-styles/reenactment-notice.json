{
  "format": 1,
  "id": "chatgpt.reenactment-notice",
  "label": "Reenactment Notice",
  "description": "Clear editorial disclosure that footage is a reenactment rather than original archival material.",
  "category": "documentary",
  "tags": [
    "reenactment-notice",
    "dafin-v7",
    "editorial"
  ],
  "kind": "lower-third",
  "sampleText": "DRAMATIZED REENACTMENT",
  "requires": {
    "fonts": [
      "Inter"
    ]
  },
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 700,
    "pixelSize": 52,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 1,
    "textCase": "upper",
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 1,
        "offsetY": 4,
        "blur": 10,
        "opacity": 0.42
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#fff8ed"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "stagger": 0,
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "boxEnabled": true,
    "boxColor": "#d915202c",
    "boxPadding": 16,
    "boxRadius": 3,
    "underlineEnabled": true,
    "underlineColor": "#ecb06f",
    "underlineWidth": 3,
    "underlineOffset": 8,
    "underlineReveal": 1
  },
  "effects": [],
  "controls": [
    {
      "id": "words",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Font size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "text_colour",
      "label": "Text colour",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box_colour",
      "label": "Panel colour",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "box_toggle",
      "label": "Show panel",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "accent_colour",
      "label": "Accent colour",
      "type": "color",
      "bind": "underline.color"
    },
    {
      "id": "entrance",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.18,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
