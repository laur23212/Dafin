{
  "format": 1,
  "id": "chatgpt.fitness-personal-best",
  "label": "Fitness Personal Best",
  "description": "Personal record marker for an athlete video, no automatic timing claim",
  "category": "utility",
  "tags": [
    "batch08",
    "functional"
  ],
  "kind": "title",
  "sampleText": "PERSONAL BEST · 5:32",
  "requires": {
    "fonts": [
      "IBM Plex Mono"
    ]
  },
  "style": {
    "fontFamily": "IBM Plex Mono",
    "fontWeight": 600,
    "pixelSize": 86,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 3.2,
    "textCase": "none",
    "boxEnabled": false,
    "boxColor": "#5E2920",
    "boxPadding": 13,
    "boxRadius": 22,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 0,
        "offsetY": 6,
        "blur": 10,
        "opacity": 0.38
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FCDEBF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "slide-up",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 20,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "fill",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "font",
      "label": "Font family",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "spacing",
      "label": "Letter spacing",
      "type": "scalar",
      "bind": "letterSpacing",
      "min": 0,
      "max": 12,
      "step": 0.2,
      "unit": "px"
    },
    {
      "id": "entrance",
      "label": "Entrance length",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
