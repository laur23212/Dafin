{
  "format": 1,
  "id": "chatgpt.editorial-pull-quote",
  "label": "Editorial Pull Quote",
  "description": "Long-form quotation with classical readable serif and calm motion.",
  "category": "documentary",
  "tags": [
    "dafin-v6",
    "practical",
    "original"
  ],
  "kind": "title",
  "sampleText": "A SMALL IDEA, A BIG CHANGE.",
  "requires": {
    "fonts": [
      "Noto Serif"
    ]
  },
  "style": {
    "fontFamily": "Noto Serif",
    "fontWeight": 600,
    "pixelSize": 67,
    "italic": true,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": 0,
    "textCase": "none",
    "boxEnabled": true,
    "boxColor": "#E0192734",
    "boxPadding": 24,
    "boxRadius": 14,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 1,
        "offsetY": 4,
        "blur": 10,
        "opacity": 0.5
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFF8E5"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "copy",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 20,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "fg",
      "label": "Text colour",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "bg",
      "label": "Box colour",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "enter",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
