{
  "format": 1,
  "id": "chatgpt.product-dimensions",
  "label": "Product Dimensions",
  "description": "Technical product-size caption with restrained lab-style styling",
  "category": "product",
  "tags": [
    "chatgpt-v10",
    "functional",
    "product"
  ],
  "kind": "lower-third",
  "sampleText": "42 × 18 CM",
  "requires": {
    "fonts": [
      "IBM Plex Mono"
    ]
  },
  "style": {
    "fontFamily": "IBM Plex Mono",
    "fontWeight": 500,
    "pixelSize": 69,
    "italic": false,
    "align": "left",
    "valign": "bottom",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0,
    "textCase": "upper",
    "layers": [
      {
        "id": "halo",
        "kind": "glow",
        "paint": {
          "kind": "solid",
          "color": "#EAC18D"
        },
        "blur": 12,
        "spread": 1,
        "opacity": 0.35
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#10232B"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "pop",
        "params": {
          "duration": 0.11,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut",
          "from": 75
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "boxEnabled": true,
    "boxColor": "#E6EFF4F2",
    "boxPadding": 16,
    "boxRadius": 10
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Edit words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "boxcolor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
