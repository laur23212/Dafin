{
  "format": 1,
  "id": "chatgpt.course-checkpoint",
  "label": "Course Checkpoint",
  "description": "Lesson section checkpoint distinct from course learning objectives",
  "category": "education",
  "tags": [
    "batch08",
    "functional"
  ],
  "kind": "title",
  "sampleText": "CHECKPOINT 03 / 08",
  "requires": {
    "fonts": [
      "Inter"
    ]
  },
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 400,
    "pixelSize": 86,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 2.4,
    "textCase": "none",
    "boxEnabled": true,
    "boxColor": "#164D3B",
    "boxPadding": 13,
    "boxRadius": 2,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 0,
        "offsetY": 5,
        "blur": 6,
        "opacity": 0.38
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#D5F8DB"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "pop",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 20,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "fill",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "font",
      "label": "Font family",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "backgroundColor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance length",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
