{
  "format": 1,
  "id": "chatgpt.journey-location-tag",
  "label": "Journey Location Tag",
  "description": "Minimal travel location caption with a restrained orange accent.",
  "category": "travel",
  "tags": [
    "dafin",
    "chatgpt",
    "functional"
  ],
  "kind": "lower-third",
  "sampleText": "PORTO / PORTUGAL",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 600,
    "pixelSize": 76,
    "italic": false,
    "align": "left",
    "valign": "bottom",
    "wordWrap": true,
    "lineHeight": 1.15,
    "letterSpacing": 2,
    "textCase": "upper",
    "boxEnabled": false,
    "boxColor": "#B80F1927",
    "boxRadius": 0,
    "boxPadding": 0,
    "layers": [
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#1D3238"
        },
        "width": 3,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFFFFF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.12,
          "unit": "block",
          "stagger": 0,
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "underlineEnabled": true,
    "underlineColor": "#EFA660",
    "underlineWidth": 4,
    "underlineOffset": 10
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Displayed text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 175,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "color",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "entry",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.18,
      "step": 0.01,
      "unit": "s",
      "group": "Motion"
    },
    {
      "id": "accent",
      "label": "Underline color",
      "type": "color",
      "bind": "underline.color",
      "group": "Accent"
    }
  ]
}
