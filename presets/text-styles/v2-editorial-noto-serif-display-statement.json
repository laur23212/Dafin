{
  "format": 1,
  "id": "chatgpt.v2.editorial.noto-serif-display.statement",
  "label": "Noto Serif Display Statement",
  "description": "Film closing card using the exact Noto Serif Display face; editable native layers and typography.",
  "category": "v2-editorial",
  "kind": "title",
  "sampleText": "The Last Light",
  "tags": [
    "v2",
    "type-diversity",
    "editorial",
    "statement",
    "film closing card"
  ],
  "requires": {
    "fonts": [
      "Noto Serif Display"
    ],
    "minAppVersion": "1.1.0"
  },
  "style": {
    "packId": "",
    "fontFamily": "Noto Serif Display",
    "pixelSize": 80,
    "fontWeight": 500,
    "italic": false,
    "layers": [
      {
        "id": "fill",
        "kind": "fill",
        "enabled": true,
        "paint": {
          "kind": "solid",
          "color": "#ffc9a273"
        },
        "opacity": 1.0,
        "blend": "normal",
        "offsetX": 0.0,
        "offsetY": 0.0,
        "blur": 0.0,
        "width": 2.0,
        "spread": 0.0,
        "scope": "all"
      }
    ],
    "align": "center",
    "valign": "middle",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0.3,
    "textCase": "none",
    "pathBend": 0,
    "boxEnabled": false,
    "boxColor": "#ff223c50",
    "boxPadding": 12,
    "boxRadius": 1,
    "underlineEnabled": false,
    "underlineColor": "#ffc9a273",
    "underlineWidth": 2.5,
    "underlineOffset": 7,
    "animation": {
      "timing": {
        "maxReadMs": 200
      }
    }
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Typeface",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "font-size",
      "label": "Size",
      "type": "scalar",
      "bind": "pixelSize",
      "min": 28,
      "max": 240,
      "unit": "px"
    },
    {
      "id": "font-colour",
      "label": "Primary ink",
      "type": "color",
      "bind": "layer.fill.color"
    }
  ]
}
