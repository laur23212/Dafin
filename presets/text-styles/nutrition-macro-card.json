{
  "format": 1,
  "id": "chatgpt.nutrition-macro-card",
  "label": "Nutrition Macro Card",
  "description": "Single macro nutrient label for a cooking or food-explainer video",
  "category": "education",
  "tags": [
    "batch08",
    "functional"
  ],
  "kind": "lower-third",
  "sampleText": "PROTEIN · 24 G",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 500,
    "pixelSize": 48,
    "italic": false,
    "align": "left",
    "valign": "bottom",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 0.8,
    "textCase": "upper",
    "boxEnabled": true,
    "boxColor": "#493A29",
    "boxPadding": 10,
    "boxRadius": 22,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 0,
        "offsetY": 3,
        "blur": 10,
        "opacity": 0.38
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#F5E8D1"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "underlineEnabled": true,
    "underlineColor": "#F5E8D1",
    "underlineWidth": 2,
    "underlineOffset": 7
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 20,
      "max": 160,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "fill",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "font",
      "label": "Font family",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "backgroundColor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance length",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    },
    {
      "id": "accentColor",
      "label": "Rule color",
      "type": "color",
      "bind": "underline.color"
    }
  ]
}
