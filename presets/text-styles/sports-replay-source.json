{
  "format": 1,
  "id": "chatgpt.sports-replay-source",
  "label": "Sports Replay Source",
  "description": "Replay camera-angle label, not a scoreboard or score line",
  "category": "sports",
  "tags": [
    "chatgpt-v10",
    "functional",
    "sports"
  ],
  "kind": "lower-third",
  "sampleText": "REPLAY / ANGLE 2",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 700,
    "pixelSize": 79,
    "italic": false,
    "align": "left",
    "valign": "bottom",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 3,
    "textCase": "upper",
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 0,
        "offsetY": 5,
        "blur": 11,
        "opacity": 0.44
      },
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#1B2E4F"
        },
        "width": 6,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#EFF7FF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.09,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "boxEnabled": true,
    "boxColor": "#E61B2E4F",
    "boxPadding": 16,
    "boxRadius": 3
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Edit words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "box",
      "label": "Background",
      "type": "bool",
      "bind": "box.enabled"
    },
    {
      "id": "boxcolor",
      "label": "Background color",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
