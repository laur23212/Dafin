{
  "format": 1,
  "id": "chatgpt.quiz-answer-timer",
  "label": "Quiz Answer Timer",
  "description": "Manual on-screen quiz answer timing cue, without unsupported automatic countdown",
  "category": "education",
  "tags": [
    "chatgpt-v10",
    "functional",
    "education"
  ],
  "kind": "title",
  "sampleText": "ANSWER IN 5",
  "requires": {
    "fonts": [
      "Oswald"
    ]
  },
  "style": {
    "fontFamily": "Oswald",
    "fontWeight": 700,
    "pixelSize": 104,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.12,
    "letterSpacing": 3,
    "textCase": "upper",
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 0,
        "offsetY": 5,
        "blur": 11,
        "opacity": 0.44
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#FFFFFF"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.08,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "underlineEnabled": true,
    "underlineColor": "#F3A54B",
    "underlineWidth": 4,
    "underlineOffset": 7
  },
  "effects": [],
  "controls": [
    {
      "id": "text",
      "label": "Edit words",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "bind": "font.family"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 24,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Text color",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "underline",
      "label": "Underline",
      "type": "bool",
      "bind": "underline.enabled"
    },
    {
      "id": "accent",
      "label": "Accent color",
      "type": "color",
      "bind": "underline.color"
    },
    {
      "id": "entrance",
      "label": "Entrance time",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
