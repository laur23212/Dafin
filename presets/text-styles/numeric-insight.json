{
  "format": 1,
  "id": "chatgpt.numeric-insight",
  "label": "Numeric Insight",
  "description": "Hero number and comparison metric for statistics and product reports.",
  "category": "data",
  "tags": [
    "dafin-v6",
    "practical",
    "original"
  ],
  "kind": "title",
  "sampleText": "+28%",
  "requires": {
    "fonts": [
      "DM Sans"
    ]
  },
  "style": {
    "fontFamily": "DM Sans",
    "fontWeight": 700,
    "pixelSize": 148,
    "italic": false,
    "align": "center",
    "valign": "center",
    "wordWrap": true,
    "lineHeight": 1.13,
    "letterSpacing": -0.8,
    "textCase": "none",
    "boxEnabled": true,
    "boxColor": "#DE12363A",
    "boxPadding": 24,
    "boxRadius": 14,
    "layers": [
      {
        "id": "shadow",
        "kind": "shadow",
        "paint": {
          "kind": "solid",
          "color": "#000000"
        },
        "offsetX": 1,
        "offsetY": 4,
        "blur": 10,
        "opacity": 0.5
      },
      {
        "id": "outline",
        "kind": "stroke",
        "paint": {
          "kind": "solid",
          "color": "#072025"
        },
        "width": 3,
        "strokeAlign": "outside"
      },
      {
        "id": "fill",
        "kind": "fill",
        "paint": {
          "kind": "solid",
          "color": "#E9FFF8"
        }
      }
    ],
    "animation": {
      "in": {
        "preset": "fade",
        "params": {
          "duration": 0.1,
          "unit": "block",
          "stagger": 0,
          "ease": "easeOut"
        }
      },
      "out": {
        "preset": "fade",
        "params": {
          "duration": 0.14,
          "unit": "block",
          "ease": "easeIn"
        }
      },
      "timing": {
        "fit": true,
        "maxReadMs": 200
      }
    },
    "underlineEnabled": true,
    "underlineColor": "#69DDBB",
    "underlineWidth": 4,
    "underlineOffset": 8,
    "underlineReveal": 1
  },
  "effects": [],
  "controls": [
    {
      "id": "copy",
      "label": "Text",
      "type": "text",
      "bind": "text"
    },
    {
      "id": "size",
      "label": "Text size",
      "type": "scalar",
      "bind": "font.size",
      "min": 20,
      "max": 200,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "fg",
      "label": "Text colour",
      "type": "color",
      "bind": "layer.fill.color"
    },
    {
      "id": "bg",
      "label": "Box colour",
      "type": "color",
      "bind": "box.color"
    },
    {
      "id": "edge",
      "label": "Outline colour",
      "type": "color",
      "bind": "layer.outline.color"
    },
    {
      "id": "rule",
      "label": "Accent underline",
      "type": "bool",
      "bind": "underline.enabled"
    },
    {
      "id": "rulecolor",
      "label": "Accent colour",
      "type": "color",
      "bind": "underline.color"
    },
    {
      "id": "enter",
      "label": "Entrance duration",
      "type": "scalar",
      "bind": "animation.in.duration",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "s"
    }
  ]
}
