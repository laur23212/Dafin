{
  "id": "dafin.v6.tr.subject-holdout-bridge",
  "version": "1.0.0",
  "displayName": "Subject Holdout Bridge",
  "category": "cinematic",
  "description": "Requires an outgoing clip mask. The next shot replaces the environment while the subject briefly remains, then gracefully fades. If no mask exists, uses a smooth alpha-aware crossfade.",
