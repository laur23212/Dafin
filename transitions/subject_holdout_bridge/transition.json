  "audioCurve": "crossfade",
  "previewStrip": "preview_strip.webp",
  "previewFrames": 9,
  "parameters": [
    {
      "identifier": "hold",
      "displayName": "Subject hold time",
      "type": "float",
      "minValue": 0.45,
      "maxValue": 0.9,
      "defaultValue": 0.74,
      "group": "Controls"
    },
    {
      "identifier": "backgroundSpeed",
      "displayName": "Background reveal pace",
      "type": "float",
      "minValue": 0.35,
      "maxValue": 0.82,
      "defaultValue": 0.6,
      "group": "Controls"
    },
    {
      "identifier": "edgeSoftness",
      "displayName": "Mask edge smoothing",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
