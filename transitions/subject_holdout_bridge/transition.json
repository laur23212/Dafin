      "displayName": "Subject lift",
      "type": "float",
      "minValue": 0,
      "maxValue": 0.045,
      "defaultValue": 0.014,
      "group": "Controls"
    }
  ],
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [
          {
            "type": "source_texture",
            "index": 0
          },
          {
            "type": "source_texture",
            "index": 1
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  },
  "requires": "mask"
}
