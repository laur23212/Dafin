{
  "id": "chatgpt.fx.masked-subject-paper-stencil",
  "displayName": "Subject Paper Stencil",
  "category": "retro",
  "description": "Reveal a supplied subject as a high-contrast two-ink print while leaving the background full color.",
  "order": 10155,
  "backend": "gpu",
  "parameters": [
    {
      "identifier": "strength",
      "displayName": "Stencil print",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.78
    },
    {
      "identifier": "threshold",
      "displayName": "Ink threshold",
      "type": "float",
      "minValue": 0.18,
      "maxValue": 0.85,
      "defaultValue": 0.53
    },
    {
      "identifier": "paper",
      "displayName": "Paper ink",
      "type": "color",
      "defaultValue": "#f3dfa8"
    }
  ],
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [
          {
            "type": "source_texture"
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  },
  "thumbnail": "thumbnail.webp",
  "requires": "mask"
}
