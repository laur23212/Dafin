{
  "id": "chatgpt.fx.masked-floor-reflection",
  "displayName": "Masked Floor Reflection",
  "category": "dreamy",
  "description": "Copies only the existing masked silhouette into a fading reflection below an adjustable horizon for stylized product or performance scenes.",
  "order": 7608,
  "backend": "gpu",
  "parameters": [
    {
      "identifier": "strength",
