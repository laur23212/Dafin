    },
    {
      "identifier": "ripple",
      "displayName": "Mirror waviness",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.29,
      "group": "Controls"
    }
  ],
  "pipeline": {
    "intermediateBuffers": [],
