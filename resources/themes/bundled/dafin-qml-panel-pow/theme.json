{
  "name": "dafin-qml-panel-pow",
  "schemaVersion": 1,
  "extends": "light",
  "variant": "light",
  "palette": {
    "appBackground": "#F6F6F3",
    "foreground": "#16293E",
    "border": "#173149",
    "accent": "#FFE157",
    "accentForeground": "#16293E",
    "mutedForeground": "#41556C",
    "popoverHover": "#F9C353",
    "panelBackground": "#FFFFFF",
    "panelForeground": "#16293E",
    "panelBorder": "#173149",
    "panelAccent": "#FFE157",
    "panelAccentForeground": "#16293E",
    "panelMuted": "#ECF1F4",
    "panelSecondaryBg": "#FFE157",
    "panelSecondaryBorder": "#D7263D",
    "panelSecondaryForeground": "#16293E",
    "sliderTrack": "#173149",
    "scrollbarTrack": "#ECF1F4",
    "scrollbarHandle": "#173149",
    "scrollbarHandleHover": "#D7263D",
    "scrollbarHandlePressed": "#D1253D",
    "sheetHandle": "#173149",
    "primary": "#D1253D",
    "primaryForeground": "#FFFFFF",
    "accentOnPanel": "#D1253D",
    "skeleton": "#FFE157",
    "skeletonHighlight": "#FFF6CD",
    "exportGradientTop": "#7C4E74",
    "exportGradientBottom": "#D1253D",
    "exportGlow": "#D7263D",
    "snapGuide": "#D7263D",
    "textStylePreviewBg": "#ECF1F4",
