    "startScreenProjectRow": {
      "radius": 4
    },
    "themedButton": {
      "radius": 2,
      "borderWidth": 1
    },
    "themedChip": {
      "radius": 2
    },
    "iconButton": {
      "radius": 2
    },
    "themedTextField": {
      "radius": 2,
      "borderWidthFocus": 2
    },
    "themedComboBox": {
      "radius": 2
    },
    "themedContextMenu": {
      "radius": 4
    },
    "themedDialog": {
      "radius": 4
    },
    "themedToolTip": {
      "radius": 2
    },
    "timelineClipItem": {
      "radius": 0
    },
    "timelinePanel": {
      "trackBackground": "$palette.panelAccent"
    },
    "timelineToolbar": {
      "background": "$palette.panelBackground"
    },
    "editorHeader": {
      "background": "$palette.appBackground"
    },
    "timelinePlayheadLine": {
      "foreground": "$palette.snapGuide"
    },
    "themedSliderHandle": {
      "radius": 2
    }
