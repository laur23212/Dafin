  "metrics": {
    "radius": {
      "xs": 0,
      "sm": 2,
      "md": 4,
      "lg": 5
    },
    "controlHeight": {
      "pointer": 33,
      "touch": 44
    },
    "controlHeightSm": {
      "pointer": 30,
      "touch": 40
    },
    "iconButtonSize": {
      "pointer": 32,
      "touch": 44
    },
    "panelGap": 5,
    "pagePadding": 10,
    "borderWidth": 2,
    "borderWidthFocus": 3,
    "iconSize": {
      "sm": 12,
      "md": 14,
      "base": 16,
      "lg": 18,
      "xl": 22
    }
  },
  "typography": {
    "fontSize": {
      "xs": 12.0,
      "sm": 13.2,
      "base": 15.0,
      "tiny": 10.0,
      "tick": 10.5,
      "card": 11.8
